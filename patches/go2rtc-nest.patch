diff --git a/pkg/webrtc/nest_gate_test.go b/pkg/webrtc/nest_gate_test.go
new file mode 100644
index 0000000..e26f358
--- /dev/null
+++ b/pkg/webrtc/nest_gate_test.go
@@ -0,0 +1,154 @@
+package webrtc
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func withNestTimeouts(t *testing.T, video, sprop time.Duration) {
+	oldVideo, oldSprop := NestVideoTimeout, NestSpropTimeout
+	NestVideoTimeout, NestSpropTimeout = video, sprop
+	t.Cleanup(func() { NestVideoTimeout, NestSpropTimeout = oldVideo, oldSprop })
+}
+
+// SPS/PPS that arrive after WaitNestVideo gave up on them must not be written:
+// the Conn is published by then and consumers are reading the codec.
+func TestNestGate_LateSpropIsNotWritten(t *testing.T) {
+	withNestTimeouts(t, 5*time.Second, 200*time.Millisecond)
+	conn, _ := dialFakeCamera(t, "nest/webrtc", camOpts{spropAfter: time.Second})
+	require.NoError(t, conn.WaitNestVideo())
+
+	// read straight through the moment the camera starts sending SPS/PPS
+	fmtp := readVideoFmtp(conn, 2*time.Second)
+	require.NotContains(t, fmtp, "sprop-parameter-sets=")
+}
+
+// A camera that never sends SPS/PPS still gets its Conn, after the sprop window.
+func TestNestGate_NoSpropStillPublishes(t *testing.T) {
+	withNestTimeouts(t, 5*time.Second, 300*time.Millisecond)
+	conn, _ := dialFakeCamera(t, "nest/webrtc", camOpts{spropAfter: -1})
+
+	start := time.Now()
+	require.NoError(t, conn.WaitNestVideo())
+	require.GreaterOrEqual(t, time.Since(start), 300*time.Millisecond)
+	require.False(t, strings.Contains(readVideoFmtp(conn, 100*time.Millisecond), "sprop-parameter-sets="))
+}
+
+// A video codec whose answer already carries sprop-parameter-sets has nothing to
+// capture, so the gate must not sit out NestSpropTimeout waiting for SPS/PPS.
+func TestNestGate_SpropInAnswerDoesNotWait(t *testing.T) {
+	withNestTimeouts(t, 5*time.Second, 10*time.Second)
+	conn, _ := dialFakeCamera(t, "nest/webrtc", camOpts{spropAfter: -1,
+		answerFmtp: "sprop-parameter-sets=Z0LgH4yNQFAe0A==,aM48gA=="})
+
+	start := time.Now()
+	require.NoError(t, conn.WaitNestVideo())
+	require.Less(t, time.Since(start), 5*time.Second, "waited for SPS/PPS the answer already had")
+	require.Equal(t, 1, strings.Count(videoMedia(t, conn).Codecs[0].FmtpLine, "sprop-parameter-sets="))
+}
+
+// No video at all is not a dial failure: the Conn is returned once NestVideoTimeout
+// passes, and the connect watchdog and reconnect loop deal with it as they always did.
+func TestNestGate_NoVideoStillPublishes(t *testing.T) {
+	withNestTimeouts(t, 300*time.Millisecond, time.Second)
+	conn := newNestConn(t)
+
+	start := time.Now()
+	require.NoError(t, conn.WaitNestVideo())
+	require.GreaterOrEqual(t, time.Since(start), 300*time.Millisecond)
+}
+
+// A video track that arrives after NestVideoTimeout must write nothing shared, and
+// must still reach a consumer that attached in the meantime. The answer lists H264
+// at PT 96 first, while the camera sends PT 97, so this is the #2389 mismatch.
+func TestNestGate_LateVideoAfterTimeout(t *testing.T) {
+	withNestTimeouts(t, 200*time.Millisecond, 200*time.Millisecond)
+	conn, _ := dialFakeCamera(t, "nest/webrtc", camOpts{spropAfter: 300 * time.Millisecond, videoAfter: time.Second})
+	require.NoError(t, conn.WaitNestVideo())
+
+	video := attachConsumer(t, conn, core.KindVideo, core.CodecH264)
+
+	fmtp := readVideoFmtp(conn, 2*time.Second) // across the late track's arrival
+	require.NotContains(t, fmtp, "sprop-parameter-sets=")
+	require.Eventually(t, func() bool { return video.Load() > 0 }, 3*time.Second, 20*time.Millisecond,
+		"late video was not delivered to the consumer")
+	require.Greater(t, len(videoMedia(t, conn).Codecs), 1, "late track narrowed a published media")
+}
+
+// The point of the gate for #2389: once WaitNestVideo returns, the video media lists
+// only the codec actually sent, so a consumer's MatchMedia/GetTrack lands on the
+// receiver OnTrack feeds, even though the answer listed another H264 first.
+func TestNestGate_VideoNarrowedBeforePublish(t *testing.T) {
+	withNestTimeouts(t, 5*time.Second, 200*time.Millisecond)
+	conn, cam := dialFakeCamera(t, "nest/webrtc", camOpts{spropAfter: -1})
+	require.NoError(t, conn.WaitNestVideo())
+
+	media := videoMedia(t, conn)
+	require.Len(t, media.Codecs, 1)
+	sent := media.Codecs[0]
+	require.Contains(t, sent.FmtpLine, "profile-level-id=42e01f") // the camera's track
+	require.NotEqual(t, firstH264PT(t, cam.pc.LocalDescription().SDP), sent.PayloadType,
+		"answer must list another H264 first, or this doesn't test #2389")
+
+	conn.tracksMu.Lock()
+	fed := append([]*core.Receiver(nil), conn.Receivers...)
+	conn.tracksMu.Unlock()
+	require.Len(t, fed, 1) // OnTrack's
+
+	want := &core.Media{Kind: core.KindVideo, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecH264}}}
+	prodCodec, _ := media.MatchMedia(want)
+	track, err := conn.GetTrack(media, prodCodec)
+	require.NoError(t, err)
+	require.Same(t, fed[0], track)
+}
+
+func videoMedia(t *testing.T, conn *Conn) *core.Media {
+	for _, media := range conn.GetMedias() {
+		if media.Kind == core.KindVideo {
+			return media
+		}
+	}
+	t.Fatal("no video media")
+	return nil
+}
+
+func firstH264PT(t *testing.T, sdp string) uint8 {
+	for _, line := range strings.Split(sdp, "\n") {
+		var pt uint8
+		if _, err := fmt.Sscanf(line, "a=rtpmap:%d H264/", &pt); err == nil {
+			return pt
+		}
+	}
+	t.Fatal("no H264 in the answer")
+	return 0
+}
+
+// A connection that closes during the wait fails the dial at once.
+func TestNestGate_CloseFailsAtOnce(t *testing.T) {
+	withNestTimeouts(t, 10*time.Second, time.Second)
+	conn := newNestConn(t)
+
+	go func() {
+		time.Sleep(100 * time.Millisecond)
+		_ = conn.Close()
+	}()
+
+	start := time.Now()
+	require.ErrorContains(t, conn.WaitNestVideo(), "closed")
+	require.Less(t, time.Since(start), 5*time.Second)
+}
+
+func newNestConn(t *testing.T) *Conn {
+	pc, err := webrtc.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+	conn := NewConn(pc)
+	conn.FormatName = "nest/webrtc"
+	t.Cleanup(func() { _ = conn.Close() })
+	return conn
+}
diff --git a/pkg/webrtc/nest_reorder.go b/pkg/webrtc/nest_reorder.go
new file mode 100644
index 0000000..b2a3ff3
--- /dev/null
+++ b/pkg/webrtc/nest_reorder.go
@@ -0,0 +1,248 @@
+package webrtc
+
+import (
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/pion/rtp/codecs"
+)
+
+// Nest retransmissions are commonly delayed by tens to hundreds of
+// milliseconds. Multi-camera diagnostics observed p99 around 277ms, so wait
+// up to 300ms for a missing sequence number. The wait applies only while a
+// sequence gap is open and adds no latency to normal in-order traffic.
+//
+// Bound pending packets as well as time. Real traces have shown retransmitted
+// packets arriving more than 50 sequence numbers behind the newest packet, so
+// 128 leaves margin while keeping the queue strictly bounded.
+const (
+	nestRTPReorderMaxWait    = 300 * time.Millisecond
+	nestRTPReorderMaxPending = 128
+)
+
+type nestRTPReorderResult struct {
+	packets    []*rtp.Packet
+	gapExpired bool
+	missing    uint16
+
+	reanchored bool
+	oldHead    uint16
+	newSeq     uint16
+}
+
+type nestRTPReorder struct {
+	started bool
+	next    uint16
+
+	pending  map[uint16]*rtp.Packet
+	gapSince time.Time
+
+	// A sustained run of packets that all appear behind the playout head can
+	// indicate that the sender reset its RTP sequence number while keeping the
+	// same SSRC. A single late packet must not disturb a healthy stream.
+	behindHead int
+}
+
+// push accepts RTP packets in arrival order and returns packets that are safe
+// to emit in sequence order.
+//
+// A sequence gap starts a bounded wait. If the missing packet arrives within
+// the window, buffered packets are released in order. If the window expires,
+// the missing sequence numbers are abandoned and any later retransmission of
+// them is dropped as late.
+//
+// Sequence comparisons deliberately use signed 16-bit differences so RTP
+// wraparound (65535 -> 0) is handled naturally.
+func (r *nestRTPReorder) push(packet *rtp.Packet, now time.Time) nestRTPReorderResult {
+	var result nestRTPReorderResult
+
+	if !r.started {
+		r.started = true
+		r.next = packet.SequenceNumber
+		r.pending = make(map[uint16]*rtp.Packet)
+	}
+
+	// Expire an existing gap BEFORE considering the newly arrived packet.
+	// Therefore a retransmission arriving after the 300ms deadline cannot
+	// retroactively heal a gap whose wait window has already elapsed.
+	if !r.gapSince.IsZero() && now.Sub(r.gapSince) >= nestRTPReorderMaxWait {
+		packets, missing := r.expireGap(now)
+		result.packets = append(result.packets, packets...)
+		if missing != 0 {
+			result.gapExpired = true
+			result.missing += missing
+		}
+	}
+
+	diff := int16(packet.SequenceNumber - r.next)
+
+	// Behind the playout head: normally an ordinary duplicate or a
+	// retransmission that arrived after its reorder window expired.
+	//
+	// Signed 16-bit RTP sequence comparisons are intentionally ambiguous for
+	// jumps of half the sequence space or more. If a sustained run of packets
+	// all appears behind the head, assume the sender reset its sequence number
+	// while retaining the same SSRC and re-anchor on the current packet.
+	if diff < 0 {
+		r.behindHead++
+		if r.behindHead < nestRTPReorderMaxPending {
+			return result
+		}
+
+		result.reanchored = true
+		result.oldHead = r.next
+		result.newSeq = packet.SequenceNumber
+
+		r.next = packet.SequenceNumber
+		r.pending = make(map[uint16]*rtp.Packet)
+		r.gapSince = time.Time{}
+		r.behindHead = 0
+
+		r.pending[packet.SequenceNumber] = packet
+		result.packets = append(result.packets, r.drain(now)...)
+		return result
+	}
+
+	// Any packet at or ahead of the current head breaks a behind-head streak.
+	r.behindHead = 0
+
+	// A packet already waiting in the queue is a duplicate retransmission.
+	if _, ok := r.pending[packet.SequenceNumber]; ok {
+		return result
+	}
+
+	// Payload contents intentionally do not matter here. In particular,
+	// zero-payload padding packets still occupy RTP sequence numbers and must
+	// fill their slot even though the caller won't forward their payload.
+	r.pending[packet.SequenceNumber] = packet
+	result.packets = append(result.packets, r.drain(now)...)
+
+	// If the time window hasn't fired but the queue reaches its hard bound,
+	// abandon the current gap rather than allowing unbounded growth.
+	if len(r.pending) >= nestRTPReorderMaxPending {
+		packets, missing := r.expireGap(now)
+		result.packets = append(result.packets, packets...)
+		if missing != 0 {
+			result.gapExpired = true
+			result.missing += missing
+		}
+	}
+
+	return result
+}
+
+type nestRTPWriteResult struct {
+	packets           []*rtp.Packet
+	waitPartitionHead bool
+	recovered         bool
+	recoveredSeq      uint16
+}
+
+// nestRTPPacketsToWrite applies the post-reorder H264 recovery gate.
+//
+// After an abandoned gap or sequence re-anchor, packets are suppressed
+// until a partition head arrives so orphan fragments are never forwarded.
+// Padding occupies sequence-number space but is never written downstream.
+func nestRTPPacketsToWrite(
+	result nestRTPReorderResult,
+	waitPartitionHead bool,
+	partitionHead *codecs.H264Packet,
+) nestRTPWriteResult {
+	write := nestRTPWriteResult{
+		waitPartitionHead: waitPartitionHead || result.gapExpired || result.reanchored,
+	}
+
+	for _, packet := range result.packets {
+		if len(packet.Payload) == 0 {
+			continue
+		}
+
+		if write.waitPartitionHead {
+			if !partitionHead.IsPartitionHead(packet.Payload) {
+				continue
+			}
+
+			write.waitPartitionHead = false
+			write.recovered = true
+			write.recoveredSeq = packet.SequenceNumber
+		}
+
+		write.packets = append(write.packets, packet)
+	}
+
+	return write
+}
+
+// drain emits every contiguous packet starting at the current playout head.
+// If draining one repaired gap exposes another, the new gap receives its own
+// full wait window.
+func (r *nestRTPReorder) drain(now time.Time) []*rtp.Packet {
+	startNext := r.next
+	var packets []*rtp.Packet
+
+	for {
+		packet, ok := r.pending[r.next]
+		if !ok {
+			break
+		}
+
+		delete(r.pending, r.next)
+		packets = append(packets, packet)
+		r.next++
+	}
+
+	switch {
+	case len(r.pending) == 0:
+		r.gapSince = time.Time{}
+
+	case r.next != startNext:
+		// We advanced through one repaired gap and stopped at a new one.
+		r.gapSince = now
+
+	case r.gapSince.IsZero():
+		// First packet observed beyond a newly opened gap.
+		r.gapSince = now
+	}
+
+	return packets
+}
+
+// expireGap abandons the missing sequence numbers up to the nearest buffered
+// packet ahead of the current playout head, then drains from that point.
+func (r *nestRTPReorder) expireGap(now time.Time) ([]*rtp.Packet, uint16) {
+	if len(r.pending) == 0 {
+		r.gapSince = time.Time{}
+		return nil, 0
+	}
+
+	var (
+		bestSeq      uint16
+		bestDistance int
+		found        bool
+	)
+
+	for seq := range r.pending {
+		diff := int16(seq - r.next)
+		if diff <= 0 {
+			continue
+		}
+
+		distance := int(diff)
+		if !found || distance < bestDistance {
+			bestSeq = seq
+			bestDistance = distance
+			found = true
+		}
+	}
+
+	if !found {
+		return nil, 0
+	}
+
+	missing := uint16(bestDistance)
+
+	r.next = bestSeq
+	r.gapSince = time.Time{}
+
+	return r.drain(now), missing
+}
diff --git a/pkg/webrtc/nest_reorder_test.go b/pkg/webrtc/nest_reorder_test.go
new file mode 100644
index 0000000..147421d
--- /dev/null
+++ b/pkg/webrtc/nest_reorder_test.go
@@ -0,0 +1,453 @@
+package webrtc
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/pion/rtp/codecs"
+	"github.com/stretchr/testify/require"
+)
+
+func nestTestPacket(seq uint16) *rtp.Packet {
+	return &rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: seq,
+		},
+		Payload: []byte{0x01},
+	}
+}
+
+func nestTestPadding(seq uint16) *rtp.Packet {
+	return &rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: seq,
+		},
+	}
+}
+
+func nestPacketSeqs(packets []*rtp.Packet) []uint16 {
+	seqs := make([]uint16, len(packets))
+	for i, packet := range packets {
+		seqs[i] = packet.SequenceNumber
+	}
+	return seqs
+}
+
+func TestNestRTPReorderInOrder(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	res := r.push(nestTestPacket(100), now)
+	require.Equal(t, []uint16{100}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+
+	res = r.push(nestTestPacket(101), now.Add(time.Millisecond))
+	require.Equal(t, []uint16{101}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+}
+
+func TestNestRTPReorderDelayedBurst(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	require.Empty(t,
+		r.push(nestTestPacket(103), now.Add(10*time.Millisecond)).packets,
+	)
+	require.Empty(t,
+		r.push(nestTestPacket(104), now.Add(20*time.Millisecond)).packets,
+	)
+
+	res := r.push(nestTestPacket(101), now.Add(80*time.Millisecond))
+	require.Equal(t, []uint16{101}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+
+	res = r.push(nestTestPacket(102), now.Add(100*time.Millisecond))
+	require.Equal(t, []uint16{102, 103, 104}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+}
+
+func TestNestRTPReorderDuplicate(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	require.Empty(t,
+		r.push(nestTestPacket(102), now.Add(10*time.Millisecond)).packets,
+	)
+
+	// Duplicate while the packet is still buffered.
+	require.Empty(t,
+		r.push(nestTestPacket(102), now.Add(20*time.Millisecond)).packets,
+	)
+
+	res := r.push(nestTestPacket(101), now.Add(30*time.Millisecond))
+	require.Equal(t, []uint16{101, 102}, nestPacketSeqs(res.packets))
+
+	// Duplicate after the packet was already emitted.
+	require.Empty(t,
+		r.push(nestTestPacket(101), now.Add(40*time.Millisecond)).packets,
+	)
+}
+
+func TestNestRTPReorderWraparound(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	res := r.push(nestTestPacket(65534), now)
+	require.Equal(t, []uint16{65534}, nestPacketSeqs(res.packets))
+
+	require.Empty(t,
+		r.push(nestTestPacket(0), now.Add(10*time.Millisecond)).packets,
+	)
+
+	res = r.push(nestTestPacket(65535), now.Add(20*time.Millisecond))
+	require.Equal(t, []uint16{65535, 0}, nestPacketSeqs(res.packets))
+
+	res = r.push(nestTestPacket(1), now.Add(30*time.Millisecond))
+	require.Equal(t, []uint16{1}, nestPacketSeqs(res.packets))
+}
+
+func TestNestRTPReorderPaddingFillsGap(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	require.Empty(t,
+		r.push(nestTestPacket(102), now.Add(10*time.Millisecond)).packets,
+	)
+
+	// Padding has no media payload but still consumes sequence 101.
+	res := r.push(nestTestPadding(101), now.Add(20*time.Millisecond))
+	require.Equal(t, []uint16{101, 102}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+}
+
+func TestNestRTPReorderLatePacketAfterTimeout(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	require.Empty(t,
+		r.push(nestTestPacket(102), now.Add(10*time.Millisecond)).packets,
+	)
+
+	// 101 arrives after the 300ms gap deadline. The gap must be expired
+	// first, releasing 102; 101 is then behind the playout head and dropped.
+	res := r.push(nestTestPacket(101), now.Add(311*time.Millisecond))
+
+	require.True(t, res.gapExpired)
+	require.Equal(t, uint16(1), res.missing)
+	require.Equal(t, []uint16{102}, nestPacketSeqs(res.packets))
+	require.Empty(t, r.pending)
+}
+
+func TestNestRTPReorderNewGapGetsFullWindow(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	// First gap: missing 101.
+	require.Empty(t,
+		r.push(nestTestPacket(102), now.Add(10*time.Millisecond)).packets,
+	)
+
+	// A second gap already exists behind 104: missing 103.
+	require.Empty(t,
+		r.push(nestTestPacket(104), now.Add(100*time.Millisecond)).packets,
+	)
+
+	// Repair the first gap at 150ms. This emits 101,102 and starts a fresh
+	// timer for the newly exposed gap at 103.
+	res := r.push(nestTestPacket(101), now.Add(150*time.Millisecond))
+	require.Equal(t, []uint16{101, 102}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+
+	// Only 100ms has elapsed for the second gap, so it must NOT expire.
+	res = r.push(nestTestPacket(105), now.Add(250*time.Millisecond))
+	require.Empty(t, res.packets)
+	require.False(t, res.gapExpired)
+
+	// Repair it within its own 300ms window.
+	res = r.push(nestTestPacket(103), now.Add(300*time.Millisecond))
+	require.Equal(t, []uint16{103, 104, 105}, nestPacketSeqs(res.packets))
+	require.False(t, res.gapExpired)
+}
+
+func TestNestRTPReorderPendingBound(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{100},
+		nestPacketSeqs(r.push(nestTestPacket(100), now).packets),
+	)
+
+	// Leave sequence 101 missing and fill the queue with 128 packets.
+	var res nestRTPReorderResult
+	for i := 0; i < nestRTPReorderMaxPending; i++ {
+		res = r.push(
+			nestTestPacket(uint16(102+i)),
+			now.Add(time.Duration(i+1)*time.Millisecond),
+		)
+	}
+
+	require.True(t, res.gapExpired)
+	require.Equal(t, uint16(1), res.missing)
+	require.Len(t, res.packets, nestRTPReorderMaxPending)
+	require.Equal(t, uint16(102), res.packets[0].SequenceNumber)
+	require.Equal(t, uint16(229), res.packets[len(res.packets)-1].SequenceNumber)
+}
+
+func TestNestRTPReorderResyncAfterLargeForwardJump(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{1000},
+		nestPacketSeqs(r.push(nestTestPacket(1000), now).packets),
+	)
+
+	// A +40000 jump is interpreted as behind by a signed 16-bit comparison.
+	// Do not re-anchor on a single packet, but recover after a sustained run.
+	start := 1001 + 40000
+	var res nestRTPReorderResult
+
+	for i := 0; i < nestRTPReorderMaxPending-1; i++ {
+		res = r.push(
+			nestTestPacket(uint16(start+i)),
+			now.Add(time.Duration(i+1)*time.Millisecond),
+		)
+		require.Empty(t, res.packets)
+	}
+
+	anchor := uint16(start + nestRTPReorderMaxPending - 1)
+	res = r.push(
+		nestTestPacket(anchor),
+		now.Add(nestRTPReorderMaxPending*time.Millisecond),
+	)
+	require.Equal(t, []uint16{anchor}, nestPacketSeqs(res.packets))
+	require.Empty(t, r.pending)
+
+	res = r.push(
+		nestTestPacket(anchor+1),
+		now.Add((nestRTPReorderMaxPending+1)*time.Millisecond),
+	)
+	require.Equal(t, []uint16{anchor + 1}, nestPacketSeqs(res.packets))
+}
+
+func TestNestRTPReorderResyncAfterBackwardJump(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(1, 0)
+
+	require.Equal(t,
+		[]uint16{1000},
+		nestPacketSeqs(r.push(nestTestPacket(1000), now).packets),
+	)
+
+	// The sender resets from expected sequence 1001 back to 465. A short run
+	// could still be delayed traffic, so only re-anchor after the threshold.
+	start := 465
+	var res nestRTPReorderResult
+
+	for i := 0; i < nestRTPReorderMaxPending-1; i++ {
+		res = r.push(
+			nestTestPacket(uint16(start+i)),
+			now.Add(time.Duration(i+1)*time.Millisecond),
+		)
+		require.Empty(t, res.packets)
+	}
+
+	anchor := uint16(start + nestRTPReorderMaxPending - 1)
+	res = r.push(
+		nestTestPacket(anchor),
+		now.Add(nestRTPReorderMaxPending*time.Millisecond),
+	)
+	require.Equal(t, []uint16{anchor}, nestPacketSeqs(res.packets))
+	require.Empty(t, r.pending)
+
+	res = r.push(
+		nestTestPacket(anchor+1),
+		now.Add((nestRTPReorderMaxPending+1)*time.Millisecond),
+	)
+	require.Equal(t, []uint16{anchor + 1}, nestPacketSeqs(res.packets))
+}
+
+func TestNestRTPPacketsToWriteWaitsForPartitionHead(t *testing.T) {
+	var partitionHead codecs.H264Packet
+
+	// A real reorder loss is declared. Padding is ignored, and the FU-A tail
+	// must not be forwarded because its partition head was lost.
+	first := nestRTPPacketsToWrite(
+		nestRTPReorderResult{
+			gapExpired: true,
+			packets: []*rtp.Packet{
+				nestTestPadding(200),
+				{
+					Header:  rtp.Header{SequenceNumber: 201},
+					Payload: []byte{0x7c, 0x05, 0xaa}, // FU-A middle/tail
+				},
+			},
+		},
+		false,
+		&partitionHead,
+	)
+
+	require.Empty(t, first.packets)
+	require.True(t, first.waitPartitionHead)
+	require.False(t, first.recovered)
+
+	// The wait state persists into the next push. Another orphan fragment is
+	// discarded; forwarding resumes exactly at the next FU-A partition head.
+	second := nestRTPPacketsToWrite(
+		nestRTPReorderResult{
+			packets: []*rtp.Packet{
+				{
+					Header:  rtp.Header{SequenceNumber: 202},
+					Payload: []byte{0x7c, 0x05, 0xbb}, // still orphaned
+				},
+				{
+					Header:  rtp.Header{SequenceNumber: 203},
+					Payload: []byte{0x7c, 0x80 | 0x05, 0xcc}, // FU-A start
+				},
+				{
+					Header:  rtp.Header{SequenceNumber: 204},
+					Payload: []byte{0x7c, 0x40 | 0x05, 0xdd}, // FU-A end
+				},
+			},
+		},
+		first.waitPartitionHead,
+		&partitionHead,
+	)
+
+	require.Equal(t, []uint16{203, 204}, nestPacketSeqs(second.packets))
+	require.False(t, second.waitPartitionHead)
+	require.True(t, second.recovered)
+	require.Equal(t, uint16(203), second.recoveredSeq)
+}
+
+func TestNestRTPReorderReanchorWaitsForPartitionHead(t *testing.T) {
+	var r nestRTPReorder
+	var head codecs.H264Packet
+	now := time.Unix(0, 0)
+	wait := false
+	var forwarded []*rtp.Packet
+
+	feed := func(p *rtp.Packet) {
+		w := nestRTPPacketsToWrite(r.push(p, now), wait, &head)
+		wait = w.waitPartitionHead
+		forwarded = append(forwarded, w.packets...)
+	}
+
+	for s := uint16(40000); s < 40010; s++ {
+		feed(&rtp.Packet{
+			Header:  rtp.Header{SequenceNumber: s},
+			Payload: []byte{0x41, 0x01},
+		})
+	}
+
+	feed(&rtp.Packet{
+		Header:  rtp.Header{SequenceNumber: 40010},
+		Payload: []byte{0x7c, 0x80 | 0x05, 0xaa},
+	})
+
+	forwarded = nil
+
+	for i := 0; i < nestRTPReorderMaxPending; i++ {
+		now = now.Add(5 * time.Millisecond)
+		feed(&rtp.Packet{
+			Header: rtp.Header{
+				SequenceNumber: uint16(39000 + i),
+			},
+			Payload: []byte{0x7c, 0x05, 0xbb},
+		})
+	}
+
+	require.Empty(t, forwarded)
+}
+
+func TestNestRTPReorderIsolatedLatePacketsNeverReanchor(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(0, 0)
+	seq := uint16(1000)
+
+	r.push(nestTestPacket(seq), now)
+
+	for i := 0; i < 3*nestRTPReorderMaxPending; i++ {
+		seq++
+		now = now.Add(10 * time.Millisecond)
+
+		res := r.push(nestTestPacket(seq), now)
+		require.Equal(t, []uint16{seq}, nestPacketSeqs(res.packets))
+
+		res = r.push(nestTestPacket(seq-50), now)
+		require.Empty(t, res.packets)
+	}
+}
+
+func TestNestRTPPacketsToWriteSkipsPaddingWhenHealthy(t *testing.T) {
+	var head codecs.H264Packet
+
+	res := nestRTPReorderResult{
+		packets: []*rtp.Packet{
+			nestTestPacket(1),
+			nestTestPadding(2),
+			nestTestPacket(3),
+		},
+	}
+
+	w := nestRTPPacketsToWrite(res, false, &head)
+
+	require.Equal(t, []uint16{1, 3}, nestPacketSeqs(w.packets))
+}
+
+func TestNestRTPReorderReanchorResetsBehindStreak(t *testing.T) {
+	var r nestRTPReorder
+	now := time.Unix(0, 0)
+
+	r.push(nestTestPacket(40000), now)
+
+	seq := uint16(39000)
+
+	// Backward reset: behind the old head in signed 16-bit terms.
+	var res nestRTPReorderResult
+
+	for i := 0; i < nestRTPReorderMaxPending; i++ {
+		res = r.push(nestTestPacket(seq), now)
+		seq++
+	}
+
+	require.True(t, res.reanchored)
+
+	// A stray packet behind the new head must not re-anchor again.
+	res = r.push(nestTestPacket(38000), now)
+
+	require.False(t, res.reanchored)
+	require.Empty(t, res.packets)
+
+	// In-order forwarding must continue normally.
+	res = r.push(nestTestPacket(seq), now)
+
+	require.Equal(t, []uint16{seq}, nestPacketSeqs(res.packets))
+}
diff --git a/pkg/webrtc/producer.go b/pkg/webrtc/producer.go
index 32e958e..d7ff336 100644
--- a/pkg/webrtc/producer.go
+++ b/pkg/webrtc/producer.go
@@ -8,6 +8,11 @@ import (
 func (c *Conn) GetTrack(media *core.Media, codec *core.Codec) (*core.Receiver, error) {
 	core.Assert(media.Direction == core.DirectionRecvonly)
 
+	// OnTrack calls this from one goroutine per remote track, and the streams layer from
+	// its own; unlocked, two calls could both miss below and one append would be lost.
+	c.tracksMu.Lock()
+	defer c.tracksMu.Unlock()
+
 	for _, track := range c.Receivers {
 		if track.Codec == codec {
 			return track, nil
@@ -47,3 +52,21 @@ func (c *Conn) Start() error {
 	c.closed.Wait()
 	return nil
 }
+
+// Stop shadows the promoted core.Connection.Stop, which the streams layer and
+// nest.WebRTCClient.Stop call. That one ranges over Receivers while a late OnTrack may
+// still be appending in GetTrack, so take a snapshot under the lock. The closes run
+// outside it, so none of them can block while holding it.
+func (c *Conn) Stop() error {
+	c.tracksMu.Lock()
+	receivers := append([]*core.Receiver(nil), c.Receivers...)
+	c.tracksMu.Unlock()
+
+	for _, receiver := range receivers {
+		receiver.Close()
+	}
+	for _, sender := range c.Senders {
+		sender.Close()
+	}
+	return c.pc.Close()
+}
diff --git a/pkg/webrtc/race_test.go b/pkg/webrtc/race_test.go
new file mode 100644
index 0000000..ad997db
--- /dev/null
+++ b/pkg/webrtc/race_test.go
@@ -0,0 +1,357 @@
+package webrtc
+
+import (
+	"encoding/binary"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	"github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+// These tests are meant to be run with -race. Each one drives a code path that
+// had an unsynchronized access, so without the fix the race detector fails it.
+
+// fakeCamera is a pion peer on loopback that answers like a camera: it sends
+// H264 video and, optionally, Opus audio.
+type fakeCamera struct {
+	pc    *webrtc.PeerConnection
+	video *webrtc.TrackLocalStaticRTP
+	audio *webrtc.TrackLocalStaticRTP
+
+	camOpts
+	stop chan struct{}
+	done sync.WaitGroup
+}
+
+// camOpts times a fakeCamera's streams, counted from the moment it connects.
+type camOpts struct {
+	audio      bool
+	spropAfter time.Duration // send SPS/PPS only this long after connecting (-1: never)
+	audioAfter time.Duration // start audio only this long after connecting
+	videoAfter time.Duration // start video only this long after connecting
+	answerFmtp string        // appended to every H264 fmtp line of the camera's answer
+}
+
+// dialFakeCamera connects a go2rtc Conn (as an active producer, the way
+// pkg/nest does) to a fakeCamera, and starts the camera sending.
+func dialFakeCamera(t *testing.T, formatName string, opts camOpts) (*Conn, *fakeCamera) {
+	t.Helper()
+
+	api, err := NewAPI()
+	require.NoError(t, err)
+	pc, err := api.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+
+	conn := NewConn(pc)
+	conn.FormatName = formatName
+	conn.Mode = core.ModeActiveProducer
+
+	offer, err := conn.CreateCompleteOffer([]*core.Media{
+		{Kind: core.KindAudio, Direction: core.DirectionRecvonly},
+		{Kind: core.KindVideo, Direction: core.DirectionRecvonly},
+		{Kind: "app"},
+	})
+	require.NoError(t, err)
+
+	cam := &fakeCamera{camOpts: opts, stop: make(chan struct{})}
+	cam.pc, err = webrtc.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+
+	cam.video, err = webrtc.NewTrackLocalStaticRTP(webrtc.RTPCodecCapability{
+		MimeType: webrtc.MimeTypeH264, ClockRate: 90000,
+		SDPFmtpLine: "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f",
+	}, "video", "cam")
+	require.NoError(t, err)
+	_, err = cam.pc.AddTrack(cam.video)
+	require.NoError(t, err)
+
+	if opts.audio {
+		cam.audio, err = webrtc.NewTrackLocalStaticRTP(webrtc.RTPCodecCapability{
+			MimeType: webrtc.MimeTypeOpus, ClockRate: 48000, Channels: 2,
+		}, "audio", "cam")
+		require.NoError(t, err)
+		_, err = cam.pc.AddTrack(cam.audio)
+		require.NoError(t, err)
+	}
+
+	require.NoError(t, cam.pc.SetRemoteDescription(webrtc.SessionDescription{Type: webrtc.SDPTypeOffer, SDP: offer}))
+	answer, err := cam.pc.CreateAnswer(nil)
+	require.NoError(t, err)
+	gathered := webrtc.GatheringCompletePromise(cam.pc)
+	require.NoError(t, cam.pc.SetLocalDescription(answer))
+	<-gathered
+
+	// Start sending BEFORE SetAnswer. A goroutine started after it would give the
+	// race detector a happens-before edge from everything SetAnswer wrote to the
+	// camera's sends, and from there (through pion's shared locks) to our OnTrack.
+	// A real camera has no such edge, and the edge hid the SetAnswer race.
+	cam.done.Add(1)
+	go cam.send()
+
+	answerSDP := cam.pc.LocalDescription().SDP
+	if opts.answerFmtp != "" {
+		// pion's answer echoes the offer's fmtp, so a camera that puts more in its
+		// answer, as a camera could, is simulated by editing the SDP.
+		var h264 []string
+		for _, line := range strings.Split(answerSDP, "\r\n") {
+			var pt int
+			if _, err := fmt.Sscanf(line, "a=rtpmap:%d H264/", &pt); err == nil {
+				h264 = append(h264, fmt.Sprintf("a=fmtp:%d ", pt))
+			}
+		}
+		lines := strings.Split(answerSDP, "\r\n")
+		for i, line := range lines {
+			for _, prefix := range h264 {
+				if strings.HasPrefix(line, prefix) {
+					lines[i] = line + ";" + opts.answerFmtp
+				}
+			}
+		}
+		answerSDP = strings.Join(lines, "\r\n")
+		require.Contains(t, answerSDP, opts.answerFmtp)
+	}
+	require.NoError(t, conn.SetAnswer(answerSDP))
+
+	t.Cleanup(func() {
+		close(cam.stop)
+		cam.done.Wait()
+		_ = cam.pc.Close()
+		_ = conn.Close()
+	})
+	return conn, cam
+}
+
+var (
+	testSPS = []byte{0x67, 0x42, 0xe0, 0x1f, 0x8c, 0x8d, 0x40, 0x50, 0x1e, 0xd0}
+	testPPS = []byte{0x68, 0xce, 0x3c, 0x80}
+)
+
+func (cam *fakeCamera) send() {
+	defer cam.done.Done()
+
+	t := time.NewTicker(10 * time.Millisecond)
+	defer t.Stop()
+
+	// spropAfter and audioAfter count from the connection, not from the first
+	// write: packets written before it are dropped.
+	var start time.Time
+	var seq uint16
+	var ts uint32
+	for {
+		select {
+		case <-cam.stop:
+			return
+		case <-t.C:
+		}
+
+		if start.IsZero() {
+			if cam.pc.ConnectionState() != webrtc.PeerConnectionStateConnected {
+				continue
+			}
+			start = time.Now()
+		}
+
+		seq++
+		ts += 900
+
+		var payload []byte
+		if cam.spropAfter >= 0 && time.Since(start) >= cam.spropAfter && seq%20 == 0 {
+			// STAP-A carrying SPS + PPS, as libwebrtc bundles them ahead of an IDR
+			payload = []byte{24}
+			for _, nal := range [][]byte{testSPS, testPPS} {
+				payload = binary.BigEndian.AppendUint16(payload, uint16(len(nal)))
+				payload = append(payload, nal...)
+			}
+		} else {
+			payload = []byte{0x41, 0x9a, 0x00, 0x01} // non-IDR slice
+		}
+
+		if time.Since(start) >= cam.videoAfter {
+			_ = cam.video.WriteRTP(&rtp.Packet{
+				Header:  rtp.Header{Version: 2, Marker: true, SequenceNumber: seq, Timestamp: ts},
+				Payload: payload,
+			})
+		}
+		if cam.audio != nil && time.Since(start) >= cam.audioAfter {
+			_ = cam.audio.WriteRTP(&rtp.Packet{
+				Header:  rtp.Header{Version: 2, Marker: true, SequenceNumber: seq, Timestamp: uint32(seq) * 480},
+				Payload: []byte{0xfc, 0xff, 0xfe},
+			})
+		}
+	}
+}
+
+// waitPublishable calls the Nest dial gate when the Conn has one. It is
+// looked up through an interface so this file compiles against code without
+// the gate, where the test then shows the race the gate removes.
+func waitPublishable(t *testing.T, conn *Conn) {
+	t.Helper()
+	if g, ok := any(conn).(interface{ WaitNestVideo() error }); ok {
+		require.NoError(t, g.WaitNestVideo())
+	}
+}
+
+// Race 1: OnTrack appended sprop-parameter-sets to the published codec's
+// FmtpLine, and narrowed media.Codecs, while consumers read both (MatchMedia,
+// rtsp/mp4 Clone, h264.RTPDepay, Codec.MarshalJSON on /api/streams). The reads
+// below are what a consumer does once Dial has returned the Conn to the streams
+// layer. Audio starts late, so its track arrives after the Conn is published.
+func TestRace_NestSpropFmtpLine(t *testing.T) {
+	conn, _ := dialFakeCamera(t, "nest/webrtc", camOpts{audio: true, spropAfter: 300 * time.Millisecond, audioAfter: 1200 * time.Millisecond})
+	waitPublishable(t, conn)
+	audio := attachConsumer(t, conn, core.KindAudio, core.CodecOpus)
+
+	// keep reading until well after the audio track starts (1.2s after connecting)
+	fmtp := readVideoFmtp(conn, 2*time.Second)
+	require.Contains(t, fmtp, "sprop-parameter-sets=Z0LgH4yNQFAe0A==,aM48gA==")
+	require.Equal(t, 1, strings.Count(fmtp, "sprop-parameter-sets="))
+
+	// the consumer attached before the audio track existed must still get its packets
+	require.Eventually(t, func() bool { return audio.Load() > 0 }, 3*time.Second, 20*time.Millisecond,
+		"late audio track was not delivered to the consumer")
+}
+
+// attachConsumer wires a consumer that accepts codecName to conn the way
+// streams.AddConsumer does (MatchMedia, GetTrack, a Sender on the receiver), and
+// returns its count of received payload bytes. Call it before that track starts.
+func attachConsumer(t *testing.T, conn *Conn, kind, codecName string) *atomic.Int64 {
+	t.Helper()
+	want := &core.Media{Kind: kind, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: codecName}}}
+	for _, media := range conn.GetMedias() {
+		prodCodec, _ := media.MatchMedia(want)
+		if prodCodec == nil {
+			continue
+		}
+		track, err := conn.GetTrack(media, prodCodec)
+		require.NoError(t, err)
+
+		var n atomic.Int64
+		sender := core.NewSender(want, prodCodec)
+		sender.Handler = func(packet *rtp.Packet) { n.Add(int64(len(packet.Payload))) }
+		sender.HandleRTP(track)
+
+		// core.Receiver.Input ranges over its children without the lock that
+		// AppendChild and RemoveChild take, an upstream race outside these tests. So
+		// attach only before the track starts, and never detach: the sender's goroutine
+		// just idles until the test binary exits. GetTransceivers takes pion's pc.mu as
+		// a write lock, and the late OnTrack's getMediaCodec takes it again, which gives
+		// the race detector its edge from this attach to the first packet. The edge
+		// holds only if this runs before that OnTrack, which the callers' camOpts
+		// delays (audioAfter, videoAfter) arrange in wall-clock time.
+		_ = conn.pc.GetTransceivers()
+		return &n
+	}
+	t.Fatalf("no %s media offers %s", kind, codecName)
+	return nil
+}
+
+// readVideoFmtp reads every media's codecs as a consumer would, repeatedly for
+// d, and returns the last video FmtpLine it saw.
+func readVideoFmtp(conn *Conn, d time.Duration) (fmtp string) {
+	for deadline := time.Now().Add(d); time.Now().Before(deadline); time.Sleep(5 * time.Millisecond) {
+		for _, media := range conn.GetMedias() {
+			for _, codec := range media.Codecs {
+				clone := codec.Clone() // as pkg/rtsp/consumer.go
+				if media.Kind == core.KindVideo {
+					fmtp = clone.FmtpLine
+				}
+			}
+		}
+	}
+	return
+}
+
+// Race 2: GetTrack's lookup-or-append on Receivers ran unlocked, while OnTrack
+// calls it from one goroutine per remote track (and the streams layer from its own).
+func TestRace_GetTrackConcurrentAppend(t *testing.T) {
+	pc, err := webrtc.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+	conn := NewConn(pc)
+	conn.Mode = core.ModeActiveProducer
+	t.Cleanup(func() { _ = conn.Close() })
+
+	media := &core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly}
+
+	const perWorker = 50
+	var wg sync.WaitGroup
+	for w := 0; w < 2; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < perWorker; i++ {
+				_, _ = conn.GetTrack(media, &core.Codec{Name: core.CodecH264})
+			}
+		}()
+	}
+	wg.Wait()
+
+	require.Len(t, conn.Receivers, 2*perWorker) // none lost to a concurrent append
+}
+
+// Race 3: the promoted core.Connection.Stop iterated Receivers while a late
+// OnTrack could still be appending in GetTrack.
+func TestRace_StopWhileGetTrack(t *testing.T) {
+	pc, err := webrtc.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+	conn := NewConn(pc)
+	conn.Mode = core.ModeActiveProducer
+
+	media := &core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly}
+	_, _ = conn.GetTrack(media, &core.Codec{Name: core.CodecH264})
+
+	started := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = conn.GetTrack(media, &core.Codec{Name: core.CodecH264})
+		close(started)
+		for i := 0; i < 2000; i++ {
+			_, _ = conn.GetTrack(media, &core.Codec{Name: core.CodecH264})
+		}
+	}()
+
+	<-started // every append after this one is concurrent with Stop
+	require.NoError(t, conn.Stop())
+	<-done
+}
+
+// Race 4: SetAnswer assigned c.Medias after SetRemoteDescription, which starts
+// the transports whose OnTrack reads c.Medias in getMediaCodec. Video only, and
+// not Nest, so the read loop has no other shared write to trip over.
+func TestRace_SetAnswerMediasBeforeOnTrack(t *testing.T) {
+	conn, _ := dialFakeCamera(t, "webrtc", camOpts{})
+	requireMediaThenClose(t, conn)
+}
+
+// Race 5: `c.Recv += n` ran in every track's read goroutine, so audio and video
+// raced each other. MarshalJSON must still report the total.
+func TestRace_RecvFromTwoTracks(t *testing.T) {
+	conn, _ := dialFakeCamera(t, "webrtc", camOpts{audio: true})
+	requireMediaThenClose(t, conn)
+}
+
+// requireMediaThenClose lets media flow, closes the Conn and checks that bytes
+// were counted. It reads the counter, not MarshalJSON, because MarshalJSON also
+// reads Receiver.Bytes, which core.Receiver writes per packet without a lock.
+func requireMediaThenClose(t *testing.T, conn *Conn) {
+	t.Helper()
+	time.Sleep(time.Second)
+	_ = conn.Close()
+	require.Greater(t, bytesRecv(conn), 0, "no media arrived")
+}
+
+// bytesRecv reads the fixed Conn's atomic counter. Through an interface so this
+// file compiles against the code before the fix, which only had the racy Recv.
+func bytesRecv(conn *Conn) int {
+	if r, ok := any(conn).(interface{ bytesRecv() int }); ok {
+		return r.bytesRecv()
+	}
+	return conn.Recv
+}
