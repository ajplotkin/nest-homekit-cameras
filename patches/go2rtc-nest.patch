diff --git a/pkg/webrtc/teardown_guard_test.go b/pkg/webrtc/teardown_guard_test.go
new file mode 100644
index 0000000..eaf0c23
--- /dev/null
+++ b/pkg/webrtc/teardown_guard_test.go
@@ -0,0 +1,43 @@
+package webrtc
+
+import (
+	"testing"
+
+	"github.com/pion/webrtc/v4"
+)
+
+// The read-error guard in OnTrack warns only when
+// pc.SignalingState() != webrtc.SignalingStateClosed. That rests on one claim:
+// a live connection never reads Closed, and a closed one always does. If this
+// fails, the guard either spams warnings on every teardown or hides the zombie.
+func TestTeardownGuardStateTransition(t *testing.T) {
+	pc, err := webrtc.NewPeerConnection(webrtc.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// live: the guard must treat a read failure here as the zombie and WARN
+	if got := pc.SignalingState(); got == webrtc.SignalingStateClosed {
+		t.Fatalf("live connection reads %v; guard would hide a real zombie", got)
+	}
+	if !warnFor(pc) {
+		t.Fatal("guard would stay quiet on a live connection")
+	}
+
+	if err := pc.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	// torn down: any read error now is expected teardown, the guard must be QUIET
+	if got := pc.SignalingState(); got != webrtc.SignalingStateClosed {
+		t.Fatalf("closed connection reads %v, not Closed; guard would warn on teardown", got)
+	}
+	if warnFor(pc) {
+		t.Fatal("guard would warn on an ordinary teardown")
+	}
+}
+
+// warnFor mirrors the exact predicate used in conn.go's read-error path.
+func warnFor(pc *webrtc.PeerConnection) bool {
+	return pc.SignalingState() != webrtc.SignalingStateClosed
+}
diff --git a/pkg/webrtc/bad_rtp_discard_test.go b/pkg/webrtc/bad_rtp_discard_test.go
new file mode 100644
index 0000000..c3efddf
--- /dev/null
+++ b/pkg/webrtc/bad_rtp_discard_test.go
@@ -0,0 +1,67 @@
+package webrtc
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+)
+
+// A single malformed RTP packet must be discarded, not treated as a dead session.
+// -16 changed the Unmarshal error branch in OnTrack from close-and-return to
+// count-and-continue; -18 was written on top of an older copy of conn.go and
+// silently put the close back, and nothing noticed for two releases. Exercising
+// the read loop needs a live remote track, so this checks the branch's shape in
+// the source instead: it must reach a `continue` and must not call Close().
+func TestBadRTPIsDiscardedNotFatal(t *testing.T) {
+	file, err := parser.ParseFile(token.NewFileSet(), "conn.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var branch *ast.BlockStmt
+	ast.Inspect(file, func(n ast.Node) bool {
+		ifs, ok := n.(*ast.IfStmt)
+		if !ok || ifs.Init == nil {
+			return true
+		}
+		if callsMethod(ifs.Init, "Unmarshal") {
+			if branch != nil {
+				t.Fatal("more than one Unmarshal error branch in conn.go; update this test")
+			}
+			branch = ifs.Body
+		}
+		return true
+	})
+	if branch == nil {
+		t.Fatal("no `if err := packet.Unmarshal(...); err != nil` branch found in conn.go")
+	}
+
+	if callsMethod(branch, "Close") {
+		t.Error("Unmarshal error branch calls Close(): one bad packet would tear down a healthy session")
+	}
+	hasContinue := false
+	ast.Inspect(branch, func(n ast.Node) bool {
+		if b, ok := n.(*ast.BranchStmt); ok && b.Tok == token.CONTINUE {
+			hasContinue = true
+		}
+		return true
+	})
+	if !hasContinue {
+		t.Error("Unmarshal error branch never continues: a bad packet would end the read loop")
+	}
+}
+
+// callsMethod reports whether n contains a call of the form x.name(...).
+func callsMethod(n ast.Node, name string) bool {
+	found := false
+	ast.Inspect(n, func(n ast.Node) bool {
+		if call, ok := n.(*ast.CallExpr); ok {
+			if sel, ok := call.Fun.(*ast.SelectorExpr); ok && sel.Sel.Name == name {
+				found = true
+			}
+		}
+		return !found
+	})
+	return found
+}
diff --git a/pkg/core/waiter_test.go b/pkg/core/waiter_test.go
new file mode 100644
index 0000000..0cd0e98
--- /dev/null
+++ b/pkg/core/waiter_test.go
@@ -0,0 +1,59 @@
+package core
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Done must publish its error before the WaitGroup.Done that releases Wait, which
+// reads w.err without the lock. In the old order (release, then store) a waiter could
+// return the previous value, nil, for a connection that ended with an error.
+//
+// Run it with -race. The race report is what fails the old order, every time; the
+// assertion only occasionally sees nil, with or without -race, because the window is
+// a few instructions wide. Only an iteration in which Wait is already blocked when
+// Done runs exercises the bug: if Done comes first, the mutex orders the write before
+// the read and there is nothing to detect. The sleep makes the blocked case the usual
+// one; it can't make the fixed code fail, since both orders return errEnded there.
+func TestWaiterDoneErrorReachesWaiter(t *testing.T) {
+	errEnded := errors.New("ended")
+
+	for i := 0; i < 100; i++ {
+		var w Waiter
+		w.Add(1) // as a running task would, so Wait below blocks instead of auto-starting
+
+		got := make(chan error, 1)
+		go func() { got <- w.Wait() }()
+		time.Sleep(5 * time.Millisecond) // let Wait block, so Done is what releases it
+
+		w.Done(errEnded)
+
+		select {
+		case err := <-got:
+			require.ErrorIs(t, err, errEnded, "iteration %d: Wait returned before Done's error was stored", i)
+		case <-time.After(time.Second):
+			t.Fatal("Wait did not return after the last Done")
+		}
+	}
+}
+
+// A Done before anyone waits must still hand its error to a later Wait. This path
+// (the else branch in Done) was not changed by the fix; the test pins it so a future
+// reordering can't break it.
+func TestWaiterDoneBeforeWait(t *testing.T) {
+	errEnded := errors.New("ended")
+	var w Waiter
+	w.Done(errEnded)
+
+	got := make(chan error, 1)
+	go func() { got <- w.Wait() }()
+	select {
+	case err := <-got:
+		require.ErrorIs(t, err, errEnded)
+	case <-time.After(time.Second):
+		t.Fatal("Wait blocked after a Done that came first")
+	}
+}
