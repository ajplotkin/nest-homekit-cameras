+package h264
+
+import (
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func testDepay() (core.HandlerFunc, *[][]byte) {
+	got := &[][]byte{}
+
+	handler := RTPDepay(
+		&core.Codec{Name: core.CodecH264},
+		func(packet *rtp.Packet) {
+			payload := append([]byte(nil), packet.Payload...)
+			*got = append(*got, payload)
+		},
+	)
+
+	return handler, got
+}
+
+func TestRTPDepayRestartsOnNewFUAStart(t *testing.T) {
+	handler, got := testDepay()
+
+	// A complete NAL has already been accumulated in this access unit, but the
+	// RTP marker is false, so it has not yet been emitted downstream.
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 100,
+			Marker:         false,
+		},
+		Payload: []byte{0x41, 0x11, 0x22},
+	})
+
+	require.Empty(t, *got)
+
+	// Start a fragmented IDR in the same access unit, but never finish it.
+	handler(&rtp.Packet{
+		Header: rtp.Header{SequenceNumber: 101},
+		Payload: []byte{
+			0x7c,        // FU-A, NRI=3
+			0x80 | 0x05, // start, IDR
+			0xaa,
+		},
+	})
+
+	// A new FU-A start means the previous access unit was abandoned. This must
+	// discard both the unfinished FU-A and the complete NAL already in buf.
+	handler(&rtp.Packet{
+		Header: rtp.Header{SequenceNumber: 102},
+		Payload: []byte{
+			0x7c,
+			0x80 | 0x05,
+			0xbb,
+		},
+	})
+
+	// Finish the replacement IDR.
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 103,
+			Marker:         true,
+		},
+		Payload: []byte{
+			0x7c,
+			0x40 | 0x05, // end, IDR
+			0xcc,
+		},
+	})
+
+	require.Len(t, *got, 1)
+
+	// AVCC: length=3, NAL header=0x65, then only the replacement FU payload.
+	// The earlier standalone NAL (0x41 0x11 0x22) must not survive.
+	require.Equal(t,
+		[]byte{0x00, 0x00, 0x00, 0x03, 0x65, 0xbb, 0xcc},
+		(*got)[0],
+	)
+}
+
+func TestRTPDepayDropsOrphanFUAFragmentsAfterSync(t *testing.T) {
+	handler, got := testDepay()
+
+	// Establish normal synchronized operation with a complete P-frame.
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 100,
+			Marker:         true,
+		},
+		Payload: []byte{0x41, 0x11, 0x22},
+	})
+
+	require.Len(t, *got, 1)
+
+	// Middle fragment with no FU-A start.
+	handler(&rtp.Packet{
+		Header:  rtp.Header{SequenceNumber: 101},
+		Payload: []byte{0x7c, 0x05, 0xaa},
+	})
+
+	// End fragment still has no valid start.
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 102,
+			Marker:         true,
+		},
+		Payload: []byte{0x7c, 0x40 | 0x05, 0xbb},
+	})
+
+	// No corrupt synthetic IDR should have been emitted.
+	require.Len(t, *got, 1)
+}
+
+func TestRTPDepayAbandonsFragmentOnStandaloneNAL(t *testing.T) {
+	handler, got := testDepay()
+
+	// Begin a fragmented IDR.
+	handler(&rtp.Packet{
+		Header:  rtp.Header{SequenceNumber: 100},
+		Payload: []byte{0x7c, 0x80 | 0x05, 0xaa},
+	})
+
+	// Instead of an FU-A continuation, a standalone P-frame arrives.
+	// The stale fragmented state must be discarded.
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 101,
+			Marker:         true,
+		},
+		Payload: []byte{0x41, 0x33, 0x44},
+	})
+
+	require.Len(t, *got, 1)
+	require.Equal(t,
+		[]byte{0x00, 0x00, 0x00, 0x03, 0x41, 0x33, 0x44},
+		(*got)[0],
+	)
+}
+
+func TestRTPDepayDropsOrphanEndAfterStandaloneNAL(t *testing.T) {
+	handler, got := testDepay()
+
+	handler(&rtp.Packet{
+		Header:  rtp.Header{SequenceNumber: 100},
+		Payload: []byte{0x7c, 0x80 | 0x05, 0xaa},
+	})
+
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 101,
+			Marker:         true,
+		},
+		Payload: []byte{0x41, 0x33, 0x44},
+	})
+
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			SequenceNumber: 102,
+			Marker:         true,
+		},
+		Payload: []byte{0x7c, 0x40 | 0x05, 0xbb},
+	})
+
+	require.Len(t, *got, 1)
+}
diff --git a/pkg/nest/api_test.go b/pkg/nest/api_test.go
new file mode 100644
index 0000000..7d54aaa
--- /dev/null
+++ b/pkg/nest/api_test.go
@@ -0,0 +1,493 @@
+package nest
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// fakeGoogle stands in for the OAuth token endpoint and the SDM API.
+// Each token request hands out the next token: tok1, tok2, ...
+// SDM requests made with a token in revoked get a 401, even though that
+// token's clock expiry is still an hour away.
+type fakeGoogle struct {
+	tokenRequests atomic.Int32
+	tokenFail     atomic.Bool  // the token endpoint answers 500
+	expiresIn     atomic.Int32 // seconds, 0 means 3600
+
+	mu       sync.Mutex
+	revoked  map[string]bool
+	status   []int    // SDM statuses to return before the normal answer, one per request
+	bearers  []string // the token on every SDM request, in order
+	onSDM401 func()   // called before an SDM 401 is written
+}
+
+func newFakeGoogle(t *testing.T) *fakeGoogle {
+	g := &fakeGoogle{revoked: map[string]bool{}}
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/token", func(w http.ResponseWriter, r *http.Request) {
+		// assert, not require: this runs on a server goroutine, where FailNow must not be called
+		n := g.tokenRequests.Add(1)
+		assert.NoError(t, r.ParseForm())
+		assert.Equal(t, "refresh_token", r.PostForm.Get("grant_type"))
+		assert.Equal(t, "refresh", r.PostForm.Get("refresh_token"))
+		if g.tokenFail.Load() {
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		expiresIn := g.expiresIn.Load()
+		if expiresIn == 0 {
+			expiresIn = 3600
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": fmt.Sprintf("tok%d", n),
+			"expires_in":   expiresIn,
+			"token_type":   "Bearer",
+		})
+	})
+	mux.HandleFunc("/sdm/", func(w http.ResponseWriter, r *http.Request) {
+		bearer := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+
+		g.mu.Lock()
+		g.bearers = append(g.bearers, bearer)
+		revoked := g.revoked[bearer]
+		status := 0
+		if len(g.status) > 0 && !revoked { // a 401 does not use up a queued status
+			status, g.status = g.status[0], g.status[1:]
+		}
+		on401 := g.onSDM401
+		g.mu.Unlock()
+
+		if revoked {
+			if on401 != nil {
+				on401()
+			}
+			// Google's 401 has a JSON error body
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = w.Write([]byte(`{"error":{"code":401,"message":"Request had invalid authentication credentials.","status":"UNAUTHENTICATED"}}`))
+			return
+		}
+		if status != 0 {
+			w.WriteHeader(status)
+			return
+		}
+
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"results": map[string]any{
+				"answerSdp":      "answer",
+				"expiresAt":      time.Now().Add(5 * time.Minute),
+				"mediaSessionId": "session",
+			},
+		})
+	})
+
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	oldToken, oldSDM, oldDelay := tokenURL, sdmURL, busyRetryDelay
+	tokenURL = srv.URL + "/token"
+	sdmURL = srv.URL + "/sdm/"
+	busyRetryDelay = 10 * time.Millisecond
+	t.Cleanup(func() { tokenURL, sdmURL, busyRetryDelay = oldToken, oldSDM, oldDelay })
+
+	cacheMu.Lock()
+	cache = map[string]*API{}
+	cacheMu.Unlock()
+
+	return g
+}
+
+func (g *fakeGoogle) revoke(token string) {
+	g.mu.Lock()
+	g.revoked[token] = true
+	g.mu.Unlock()
+}
+
+func (g *fakeGoogle) setStatus(status ...int) {
+	g.mu.Lock()
+	g.status = status
+	g.mu.Unlock()
+}
+
+func (g *fakeGoogle) sdmBearers() []string {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return append([]string(nil), g.bearers...)
+}
+
+func cachedToken(t *testing.T) string {
+	cacheMu.Lock()
+	defer cacheMu.Unlock()
+	api := cache["client:secret:refresh"]
+	require.NotNil(t, api, "no cache entry")
+	return api.Token
+}
+
+func newTestAPI(t *testing.T) *API {
+	api, err := NewAPI("client", "secret", "refresh")
+	require.NoError(t, err)
+	return api
+}
+
+// Google revokes a token before its clock expiry. A 401 must get a new token
+// right away, not the cached one back, and the retry must succeed without the
+// 409/429 backoff.
+func TestExchangeSDP401GetsNewToken(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	require.Equal(t, "tok1", api.Token)
+	g.revoke("tok1")
+
+	answer, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.Equal(t, "answer", answer)
+	require.Equal(t, "tok2", api.Token)
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+	require.Equal(t, []string{"tok1", "tok2"}, g.sdmBearers())
+}
+
+// The new token replaces the shared cache entry, so the next camera to dial
+// starts with it instead of the revoked one, with no token request of its own.
+func TestReplacedTokenIsShared(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.revoke("tok1")
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.Equal(t, "tok2", cachedToken(t))
+
+	other := newTestAPI(t)
+	require.Equal(t, "tok2", other.Token)
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+}
+
+// Cameras that hit a 401 at the same moment make one token request between them.
+func TestConcurrent401sMakeOneTokenRequest(t *testing.T) {
+	g := newFakeGoogle(t)
+	const cameras = 4
+	apis := make([]*API, cameras)
+	for i := range apis {
+		apis[i] = newTestAPI(t)
+	}
+	require.Equal(t, int32(1), g.tokenRequests.Load())
+	g.revoke("tok1")
+
+	// Hold every 401 until all cameras have sent their request, so all of
+	// them hold the revoked token when they ask for a new one.
+	var arrived sync.WaitGroup
+	arrived.Add(cameras)
+	g.mu.Lock()
+	g.onSDM401 = func() {
+		arrived.Done()
+		arrived.Wait()
+	}
+	g.mu.Unlock()
+
+	var wg sync.WaitGroup
+	errs := make([]error, cameras)
+	for i, api := range apis {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, errs[i] = api.ExchangeSDP("project", fmt.Sprintf("device%d", i), "offer")
+		}()
+	}
+	wg.Wait()
+
+	for i, api := range apis {
+		require.NoError(t, errs[i])
+		require.Equal(t, "tok2", api.Token)
+	}
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+}
+
+// A camera whose token is older than the cache's (another camera already
+// replaced it) takes the cached one instead of asking Google again.
+func TestStale401AdoptsCachedToken(t *testing.T) {
+	g := newFakeGoogle(t)
+	first := newTestAPI(t)
+	second := newTestAPI(t)
+	g.revoke("tok1")
+
+	_, err := first.ExchangeSDP("project", "device1", "offer")
+	require.NoError(t, err)
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+
+	_, err = second.ExchangeSDP("project", "device2", "offer")
+	require.NoError(t, err)
+	require.Equal(t, "tok2", second.Token)
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+}
+
+// The retry after a 401 happens inside the request and does not use up one of
+// ExchangeSDP's three attempts: 401, then 409, 409, then success, still succeeds.
+func Test401RetryUsesNoAttempt(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.revoke("tok1")
+	g.setStatus(http.StatusConflict, http.StatusConflict)
+
+	answer, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.Equal(t, "answer", answer)
+	require.Equal(t, []string{"tok1", "tok2", "tok2", "tok2"}, g.sdmBearers())
+}
+
+// The 401 response is read to the end and closed before the token request, so
+// the connection goes back to the pool and the token request can reuse it. Go
+// before 1.27 drops a connection whose body is closed unread; 1.27 drains it,
+// but only after Close returns. So check the body itself, not the connections.
+func Test401BodyIsClosed(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.revoke("tok1")
+
+	rt := &bodyRecorder{base: http.DefaultTransport}
+	http.DefaultTransport = rt
+	// Registered after newFakeGoogle's srv.Close, so it runs first (LIFO) and
+	// srv.Close finds the real transport to close its idle connections on.
+	t.Cleanup(func() { http.DefaultTransport = rt.base })
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.Equal(t, []string{"/sdm/ 401", "/token 200", "/sdm/ 200"}, rt.log)
+	// As the token request was sent:
+	require.True(t, rt.eof, "401 body not read to EOF")
+	require.True(t, rt.closed, "401 body not closed")
+}
+
+// bodyRecorder logs each request's path and status, and records whether the
+// last 401's body had been read to EOF and closed when the next request went out.
+type bodyRecorder struct {
+	base        http.RoundTripper
+	log         []string
+	last401     *recordedBody
+	eof, closed bool
+}
+
+func (r *bodyRecorder) RoundTrip(req *http.Request) (*http.Response, error) {
+	if b := r.last401; b != nil {
+		r.eof, r.closed, r.last401 = b.eof, b.closed, nil
+	}
+	res, err := r.base.RoundTrip(req)
+	if err != nil {
+		return nil, err
+	}
+	path := req.URL.Path
+	if strings.HasPrefix(path, "/sdm/") {
+		path = "/sdm/"
+	}
+	r.log = append(r.log, fmt.Sprintf("%s %d", path, res.StatusCode))
+	if res.StatusCode == http.StatusUnauthorized {
+		r.last401 = &recordedBody{ReadCloser: res.Body}
+		res.Body = r.last401
+	}
+	return res, nil
+}
+
+type recordedBody struct {
+	io.ReadCloser
+	eof, closed bool
+}
+
+func (b *recordedBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if err == io.EOF {
+		b.eof = true
+	}
+	return n, err
+}
+
+func (b *recordedBody) Close() error {
+	b.closed = true
+	return b.ReadCloser.Close()
+}
+
+// A 409 or 429 is not a token problem: back off and retry with the same
+// token, and make no token request.
+func TestBusyMakesNoTokenRequest(t *testing.T) {
+	for _, status := range []int{http.StatusConflict, http.StatusTooManyRequests} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			g := newFakeGoogle(t)
+			api := newTestAPI(t)
+			g.setStatus(status, status)
+
+			answer, err := api.ExchangeSDP("project", "device", "offer")
+			require.NoError(t, err)
+			require.Equal(t, "answer", answer)
+			require.Equal(t, int32(1), g.tokenRequests.Load())
+			require.Equal(t, []string{"tok1", "tok1", "tok1"}, g.sdmBearers())
+		})
+	}
+}
+
+// The normal path uses the cached token: no extra token request.
+func TestCachedPathMakesNoTokenRequest(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.NoError(t, api.ExtendStream())
+	_ = newTestAPI(t)
+	require.Equal(t, int32(1), g.tokenRequests.Load())
+	require.Equal(t, []string{"tok1", "tok1"}, g.sdmBearers())
+}
+
+// Other failures than 401 make no token request either.
+func TestOtherErrorsMakeNoTokenRequest(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.setStatus(http.StatusBadRequest)
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.ErrorContains(t, err, "400")
+	require.Equal(t, int32(1), g.tokenRequests.Load())
+}
+
+// A 401 on the token that was just fetched fails rather than loops.
+func TestSecond401Fails(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.revoke("tok1")
+	g.revoke("tok2")
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.ErrorContains(t, err, "401")
+	require.Equal(t, []string{"tok1", "tok2"}, g.sdmBearers())
+}
+
+// The extend loop's ExtendStream gets the same 401 handling, so a revoked
+// token does not stop extension and stall the stream.
+func TestExtendStream401GetsNewToken(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	g.revoke("tok1")
+
+	require.NoError(t, api.ExtendStream())
+	require.Equal(t, "tok2", api.Token)
+	require.Equal(t, "tok2", cachedToken(t))
+	require.Equal(t, int32(2), g.tokenRequests.Load())
+}
+
+// If the token request after a 401 fails, the rejected token must not stay in
+// the cache: the next dial asks Google again instead of starting with it.
+func TestFailedReplaceDropsRejectedToken(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.revoke("tok1")
+	g.tokenFail.Store(true)
+
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.ErrorContains(t, err, "500")
+
+	g.tokenFail.Store(false)
+	other := newTestAPI(t)
+	require.Equal(t, "tok3", other.Token)
+}
+
+// A cached token about to expire is not handed out.
+func TestNearlyExpiredTokenIsNotCached(t *testing.T) {
+	g := newFakeGoogle(t)
+	g.expiresIn.Store(20)
+	require.Equal(t, "tok1", newTestAPI(t).Token)
+	g.expiresIn.Store(0)
+	require.Equal(t, "tok2", newTestAPI(t).Token)
+}
+
+func TestEmptyAccessTokenIsAnError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"expires_in":3600}`))
+	}))
+	t.Cleanup(srv.Close)
+	old := tokenURL
+	tokenURL = srv.URL
+	t.Cleanup(func() { tokenURL = old })
+	cacheMu.Lock()
+	cache = map[string]*API{}
+	cacheMu.Unlock()
+
+	_, err := NewAPI("client", "secret", "refresh")
+	require.Error(t, err)
+}
+
+// The 401 retry does not sleep the busy backoff. busyRetryDelay is set to an
+// hour so any sleep on the 401 path would hang the test instead of passing
+// under the 10ms value newFakeGoogle installs.
+func TestExchangeSDP401DoesNotBackOff(t *testing.T) {
+	g := newFakeGoogle(t)
+	busyRetryDelay = time.Hour
+	api := newTestAPI(t)
+	g.revoke("tok1")
+	start := time.Now()
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	require.Less(t, time.Since(start), 5*time.Second)
+	require.Equal(t, "tok2", api.Token)
+}
+
+// replaceToken updates ExpiresAt too (the extend loop keys its clock refresh
+// off it).
+func TestReplaceTokenUpdatesExpiry(t *testing.T) {
+	g := newFakeGoogle(t)
+	api := newTestAPI(t)
+	g.expiresIn.Store(7200)
+	g.revoke("tok1")
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	cacheMu.Lock()
+	exp := cache[api.key].ExpiresAt
+	cacheMu.Unlock()
+	require.Equal(t, exp, api.ExpiresAt)
+	require.Greater(t, api.ExpiresAt, time.Now().Add(90*time.Minute))
+}
+
+// A cached token that differs from the rejected one but is itself about to
+// expire is not adopted; a new one is requested.
+func TestStale401DoesNotAdoptNearlyExpiredToken(t *testing.T) {
+	g := newFakeGoogle(t)
+	first := newTestAPI(t)
+	second := newTestAPI(t) // both tok1
+	g.revoke("tok1")
+	g.expiresIn.Store(20)
+	_, err := second.ExchangeSDP("project", "device2", "offer") // replaces with tok2, 20s left
+	require.NoError(t, err)
+	require.Equal(t, "tok2", cachedToken(t))
+	g.expiresIn.Store(0)
+
+	_, err = first.ExchangeSDP("project", "device1", "offer")
+	require.NoError(t, err)
+	require.Equal(t, "tok3", first.Token)
+	require.Equal(t, int32(3), g.tokenRequests.Load())
+}
+
+// The extend loop refreshes the token by clock before extending.
+func TestExtendLoopRefreshesNearExpiry(t *testing.T) {
+	g := newFakeGoogle(t)
+	g.expiresIn.Store(20) // tok1 is inside the margin from the start
+	api := newTestAPI(t)
+	g.expiresIn.Store(0)
+	_, err := api.ExchangeSDP("project", "device", "offer")
+	require.NoError(t, err)
+	api.StreamExpiresAt = time.Now() // timer fires at once
+	api.StartExtendStreamTimer()
+	require.Eventually(t, func() bool { return len(g.sdmBearers()) >= 2 }, 5*time.Second, 10*time.Millisecond)
+	api.StopExtendStreamTimer()
+	require.Equal(t, "tok2", api.Token)
+	require.Equal(t, []string{"tok1", "tok2"}, g.sdmBearers()[:2])
+}
diff --git a/pkg/nest/client_test.go b/pkg/nest/client_test.go
new file mode 100644
index 0000000..df00580
--- /dev/null
+++ b/pkg/nest/client_test.go
@@ -0,0 +1,151 @@
+package nest
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+// The dial gate only works if rtcConn waits on it before returning the Conn: OnTrack
+// narrows the video media.Codecs and writes sprop-parameter-sets, and the streams layer
+// starts reading both as soon as Dial returns. So, as a consumer would, look at the
+// Conn the moment rtcConn returns: both writes must already be done.
+func TestRtcConnReturnsOnlyAfterTheGate(t *testing.T) {
+	cam := &loopbackCamera{t: t}
+	old := http.DefaultTransport
+	http.DefaultTransport = cam // ExchangeSDP's client uses it
+	t.Cleanup(func() { http.DefaultTransport = old })
+	oldConf := rtcConfig
+	rtcConfig = pion.Configuration{} // no STUN: host candidates only
+	t.Cleanup(func() { rtcConfig = oldConf })
+
+	client, err := rtcConn(&API{Token: "test"}, "nest:test", "project", "device")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Stop() })
+
+	var video *core.Media
+	for _, media := range client.GetMedias() {
+		if media.Kind == core.KindVideo {
+			video = media
+		}
+	}
+	require.NotNil(t, video)
+	require.Len(t, video.Codecs, 1, "rtcConn returned before OnTrack narrowed the video codecs")
+	require.Contains(t, video.Codecs[0].FmtpLine, "sprop-parameter-sets=",
+		"rtcConn returned before OnTrack wrote sprop-parameter-sets")
+}
+
+// loopbackCamera answers GenerateWebRtcStream like Google, with a local pion peer that
+// sends H264: non-IDR slices, then SPS/PPS from 300ms after it connects.
+type loopbackCamera struct {
+	t  *testing.T
+	mu sync.Mutex
+}
+
+func (c *loopbackCamera) RoundTrip(req *http.Request) (*http.Response, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	t := c.t
+	require.True(t, strings.HasSuffix(req.URL.Path, ":executeCommand"), req.URL.String())
+
+	var reqv struct {
+		Params struct {
+			Offer string `json:"offerSdp"`
+		} `json:"params"`
+	}
+	require.NoError(t, json.NewDecoder(req.Body).Decode(&reqv))
+
+	pc, err := pion.NewPeerConnection(pion.Configuration{})
+	require.NoError(t, err)
+	track, err := pion.NewTrackLocalStaticRTP(pion.RTPCodecCapability{
+		MimeType: pion.MimeTypeH264, ClockRate: 90000,
+		SDPFmtpLine: "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f",
+	}, "video", "cam")
+	require.NoError(t, err)
+	_, err = pc.AddTrack(track)
+	require.NoError(t, err)
+
+	require.NoError(t, pc.SetRemoteDescription(pion.SessionDescription{Type: pion.SDPTypeOffer, SDP: reqv.Params.Offer}))
+	answer, err := pc.CreateAnswer(nil)
+	require.NoError(t, err)
+	gathered := pion.GatheringCompletePromise(pc)
+	require.NoError(t, pc.SetLocalDescription(answer))
+	<-gathered
+
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	go sendH264(pc, track, stop, done)
+	t.Cleanup(func() {
+		close(stop)
+		<-done
+		_ = pc.Close()
+	})
+
+	var resv struct {
+		Results struct {
+			Answer         string    `json:"answerSdp"`
+			ExpiresAt      time.Time `json:"expiresAt"`
+			MediaSessionID string    `json:"mediaSessionId"`
+		} `json:"results"`
+	}
+	resv.Results.Answer = pc.LocalDescription().SDP
+	resv.Results.ExpiresAt = time.Now().Add(5 * time.Minute)
+	resv.Results.MediaSessionID = "test"
+	b, err := json.Marshal(resv)
+	require.NoError(t, err)
+
+	return &http.Response{
+		StatusCode: 200, Status: "200 OK", Header: http.Header{},
+		Body: io.NopCloser(bytes.NewReader(b)), Request: req,
+	}, nil
+}
+
+func sendH264(pc *pion.PeerConnection, track *pion.TrackLocalStaticRTP, stop, done chan struct{}) {
+	defer close(done)
+	sps := []byte{0x67, 0x42, 0xe0, 0x1f, 0x8c, 0x8d, 0x40, 0x50, 0x1e, 0xd0}
+	pps := []byte{0x68, 0xce, 0x3c, 0x80}
+
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+
+	var start time.Time
+	var seq uint16
+	for {
+		select {
+		case <-stop:
+			return
+		case <-tick.C:
+		}
+		if start.IsZero() {
+			if pc.ConnectionState() != pion.PeerConnectionStateConnected {
+				continue
+			}
+			start = time.Now()
+		}
+
+		seq++
+		payload := []byte{0x41, 0x9a, 0x00, 0x01} // non-IDR slice
+		if time.Since(start) >= 300*time.Millisecond && seq%20 == 0 {
+			payload = []byte{24} // STAP-A: SPS + PPS
+			for _, nal := range [][]byte{sps, pps} {
+				payload = binary.BigEndian.AppendUint16(payload, uint16(len(nal)))
+				payload = append(payload, nal...)
+			}
+		}
+		_ = track.WriteRTP(&rtp.Packet{
+			Header:  rtp.Header{Version: 2, Marker: true, SequenceNumber: seq, Timestamp: uint32(seq) * 900},
+			Payload: payload,
+		})
+	}
+}
